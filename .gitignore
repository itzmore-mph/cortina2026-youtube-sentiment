# ── Credentials ───────────────────────────────────────────────────────────
.env

# ── Data files ────────────────────────────────────────────────────────────
# CSVs are generated by the notebook; only the .gitkeep placeholder is tracked
data/*.csv

# ── Generated figures ─────────────────────────────────────────────────────
# Figures are produced by running the notebook; not source files
figures/*.png
figures/*.jpg
figures/*.svg

# ── Hugging Face / Transformers cache ─────────────────────────────────────
# Model weights downloaded at runtime — do not commit
.cache/
~/.cache/huggingface/
*.bin
*.safetensors
*.pt
*.pth

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
.Python
*.egg-info/
dist/
build/
.eggs/
*.so

# ── Virtual environments ──────────────────────────────────────────────────
venv/
.venv/
env/
# Conda environments are managed outside the repo
envs/

# ── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── VSCode ────────────────────────────────────────────────────────────────
.vscode/

# ── Temporary / scratch files ─────────────────────────────────────────────
*.tmp
*.log
patch_notebook.py
final_emdash_fix.py
final_polish.py
